package com.example.voicenot;

import android.os.Bundle;
import android.speech.tts.TextToSpeech;
import android.util.Log;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Button;
import android.widget.ListView;
import android.widget.ProgressBar;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

import org.json.JSONObject;

import java.io.IOException;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Locale;
import java.util.Random;

import okhttp3.Call;
import okhttp3.Callback;
import okhttp3.MediaType;
import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.RequestBody;
import okhttp3.Response;

public class Suggestions extends AppCompatActivity implements TextToSpeech.OnInitListener {
    private static final String TAG = "Suggestions";
    private ProgressBar progressBar;
    private Button btnGetSuggestions;
    private TextToSpeech textToSpeech;
    private ArrayList<String> suggestions = new ArrayList<>();
    private ArrayAdapter<String> adapter;
    private final OkHttpClient client = new OkHttpClient();

    // Enhanced local suggestions
    private final List<String> LOCAL_SUGGESTIONS = Arrays.asList(
            "Take a 10-minute walk outside to refresh your mind",
            "Try a quick 5-minute meditation session",
            "Listen to your favorite music - maybe discover a new song!",
            "Do some light stretching to improve circulation",
            "Drink a glass of water to stay hydrated",
            "Try the Pomodoro technique for better focus",
            "Call a friend or family member for a quick chat",
            "Write down three things you're grateful for today",
            "Organize your workspace for better productivity",
            "Read an interesting article or book chapter"
    );
    private int lastLocalSuggestionIndex = -1;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_suggestions);

        // Initialize UI
        ListView suggestionsListView = findViewById(R.id.suggestionsListView);
        progressBar = findViewById(R.id.progressBar);
        btnGetSuggestions = findViewById(R.id.btnGetSuggestions);

        textToSpeech = new TextToSpeech(this, this);
        adapter = new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, suggestions);
        suggestionsListView.setAdapter(adapter);

        btnGetSuggestions.setOnClickListener(v -> fetchSuggestions());
    }

    private void fetchSuggestions() {
        progressBar.setVisibility(View.VISIBLE);
        btnGetSuggestions.setEnabled(false);

        // First try real API
        attemptAPISuggestion();
    }

    private void attemptAPISuggestion() {
        String apiUrl = "https://api.deepai.org/api/text-generator";
        String prompt = "Suggest a short leisure activity (under 15 words):";

        RequestBody body = RequestBody.create(
                "text=" + prompt,
                MediaType.get("application/x-www-form-urlencoded")
        );

        Request request = new Request.Builder()
                .url(apiUrl)
                .post(body)
                .header("api-key", "quickstart-5d1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b")
                .build();

        client.newCall(request).enqueue(new Callback() {
            @Override
            public void onFailure(Call call, IOException e) {
                Log.e(TAG, "API failed", e);
                runOnUiThread(() -> {
                    showLocalSuggestion();
                    Toast.makeText(Suggestions.this, "Using local suggestion", Toast.LENGTH_SHORT).show();
                });
            }

            @Override
            public void onResponse(Call call, Response response) {
                try {
                    if (response.isSuccessful()) {
                        String responseBody = response.body().string();
                        JSONObject json = new JSONObject(responseBody);
                        String apiSuggestion = json.optString("output", "").trim();

                        if (!apiSuggestion.isEmpty()) {
                            runOnUiThread(() -> addSuggestion(apiSuggestion));
                            return;
                        }
                    }
                    // If we reach here, API failed
                    runOnUiThread(() -> {
                        showLocalSuggestion();
                        Toast.makeText(Suggestions.this, "API response empty", Toast.LENGTH_SHORT).show();
                    });
                } catch (Exception e) {
                    Log.e(TAG, "API parse error", e);
                    runOnUiThread(() -> {
                        showLocalSuggestion();
                        Toast.makeText(Suggestions.this, "API error", Toast.LENGTH_SHORT).show();
                    });
                }
            }
        });
    }

    private void showLocalSuggestion() {
        String localSuggestion = getUniqueLocalSuggestion();
        addSuggestion(localSuggestion);
    }

    private String getUniqueLocalSuggestion() {
        Random random = new Random();
        int newIndex;
        do {
            newIndex = random.nextInt(LOCAL_SUGGESTIONS.size());
        } while (newIndex == lastLocalSuggestionIndex && LOCAL_SUGGESTIONS.size() > 1);

        lastLocalSuggestionIndex = newIndex;
        return LOCAL_SUGGESTIONS.get(newIndex);
    }

    private void addSuggestion(String suggestion) {
        suggestions.add(suggestion);
        adapter.notifyDataSetChanged();
        speakSuggestion(suggestion);
        progressBar.setVisibility(View.GONE);
        btnGetSuggestions.setEnabled(true);
    }

    private void speakSuggestion(String text) {
        if (textToSpeech != null) {
            textToSpeech.speak(text, TextToSpeech.QUEUE_FLUSH, null, null);
        }
    }

    @Override
    public void onInit(int status) {
        if (status == TextToSpeech.SUCCESS) {
            int result = textToSpeech.setLanguage(Locale.US);
            if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
                Toast.makeText(this, "Voice not supported", Toast.LENGTH_SHORT).show();
            }
        }
    }

    @Override
    protected void onDestroy() {
        if (textToSpeech != null) {
            textToSpeech.stop();
            textToSpeech.shutdown();
        }
        super.onDestroy();
    }
}
